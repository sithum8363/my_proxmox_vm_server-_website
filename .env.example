# Render website
SESSION_SECRET=generate-a-long-random-value
SESSION_HTTPS_ONLY=true
PANEL_USERNAME=admin
PANEL_PASSWORD=change-this-to-a-long-unique-password
AGENT_URL=https://api.example.com
AGENT_SHARED_SECRET=use-the-same-long-random-value-on-both-services
# Optional: a Cloudflare Access service token for api.example.com.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Ubuntu agent only
PVE_HOST=192.168.1.18
PVE_PORT=8006
PVE_NODE=proxmox
PVE_API_USER=cloud-agent@pve
PVE_TOKEN_NAME=render-panel
PVE_TOKEN_VALUE=put-the-proxmox-token-secret-here
PVE_VERIFY_SSL=true
# Recommended: use a second Tunnel hostname for browser noVNC traffic, such as
# https://console.example.com. It still uses single-use console tickets.
PUBLIC_BASE_URL=https://console.example.com
TEMPLATE_ID=1000
MAX_USER_VMS=10
HOST_MEMORY_RESERVE_MB=2048
# Path on the Ubuntu VM after cloning this repository.
NOVNC_DIRECTORY=novnc
